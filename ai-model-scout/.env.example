# Copy to .env and fill in what you have. Everything is optional.
YOUTUBE_API_KEY=        # Google Cloud console -> YouTube Data API v3 (free quota)
GITHUB_TOKEN=           # raises GitHub search rate limits; no scopes needed
HF_TOKEN=               # only needed if Hugging Face rate-limits you
ANTHROPIC_API_KEY=      # enables the written weekly briefing
TELEGRAM_BOT_TOKEN=     # same bot as the SQL connector works fine
TELEGRAM_CHAT_ID=

# Copy to .env and fill in what you have. Everything is optional; leave unused lines blank.

# Google Cloud console -> YouTube Data API v3 (free quota). Adds YouTube keyword search.
YOUTUBE_API_KEY=

# Raises GitHub search rate limits. A classic token with no scopes is enough.
GITHUB_TOKEN=

# Only needed if Hugging Face rate-limits you.
HF_TOKEN=

# Enables the written weekly briefing by Claude.
ANTHROPIC_API_KEY=

# Telegram notification (the bot from the SQL connector works fine).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
